# Up to two Claude Code data directories to watch, e.g. a host dir plus a second
# machine/VM's dir mounted locally. If you only have one, set both to the same path.
#
# On Windows with WSL specifically: `docker compose` must be run from inside your WSL
# distro (e.g. a WSL terminal), not from PowerShell/cmd.exe -- Docker Desktop can't
# resolve \\wsl.localhost\... UNC paths as bind-mount sources from that direction and
# will silently mount an empty directory instead.
CLAUDE_DIR_1=/Users/YOUR_USERNAME/.claude
CLAUDE_DIR_2=/Users/YOUR_USERNAME/.claude
OPENCODE_DATA_DIR=/home/YOUR_USERNAME/.local/share/opencode
OPENCODE_CONFIG_DIR=/home/YOUR_USERNAME/.config/opencode
PORT=3001
# Root of agent-shell's host-backed Claude stores (one directory per container)
AGENT_CLAUDE_ROOT=/home/YOUR_USERNAME/.agent-shell/claude
# Both optional -- uncomment to override the defaults (14 days, 30000ms).
# STORE_ACTIVE_DAYS=14
# STORE_POLL_MS=30000
